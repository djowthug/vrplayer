{
  "name": "vrplayer",
  "version": "1.0.0",
  "description": "VR Player 360/180/3D para Windows e Web/PWA",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "cert": "node scripts/setup-cert.js",
    "electron": "electron .",
    "optimize": "node scripts/batch-optimize.js",
    "clean": "node scripts/clean.js",
    "clean:cache": "node scripts/clean.js --cache",
    "clean:all": "node scripts/clean.js --all",
    "check": "node --check server.js && node --check electron/main.cjs && node --check electron/preload.cjs && node --check scripts/batch-optimize.js && node --check scripts/clean.js",
    "bin": "node scripts/setup-binaries.js",
    "setup:bin": "node scripts/setup-binaries.js",
    "predist": "node scripts/setup-binaries.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:dir": "electron-builder --win --dir"
  },
  "keywords": [
    "vr",
    "player",
    "threejs",
    "pwa",
    "desktop",
    "electron",
    "windows"
  ],
  "author": "djowthug",
  "license": "MIT",
  "dependencies": {
    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.vrplayer.app",
    "productName": "VR Player",
    "copyright": "Copyright © 2026 djowthug",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "icons/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe",
          "mkcert.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon-512.png",
      "fileAssociations": [
        {
          "ext": "mp4",
          "name": "Vídeo MP4",
          "role": "Viewer"
        },
        {
          "ext": "mkv",
          "name": "Vídeo MKV",
          "role": "Viewer"
        },
        {
          "ext": "webm",
          "name": "Vídeo WebM",
          "role": "Viewer"
        },
        {
          "ext": "mov",
          "name": "Vídeo QuickTime",
          "role": "Viewer"
        },
        {
          "ext": "m4v",
          "name": "Vídeo M4V",
          "role": "Viewer"
        },
        {
          "ext": "avi",
          "name": "Vídeo AVI",
          "role": "Viewer"
        },
        {
          "ext": "ts",
          "name": "Vídeo MPEG-TS",
          "role": "Viewer"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VR Player"
    }
  },
  "dependencies": {
    "bonjour-service": "^1.4.4"
  }
}
