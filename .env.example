# ==============================================================================
# VR PLAYER - TEMPLATE DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Instruções de Uso:
# 1. Copie este arquivo para ".env" na raiz do projeto:
#    cp .env.example .env (Linux/macOS) ou copy .env.example .env (Windows)
# 2. Preencha ou modifique as variáveis conforme o seu ambiente local ou de produção.
# 3. NUNCA faça commit do arquivo ".env" contendo credenciais ou chaves reais!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AMBIENTE E LOGS
# ------------------------------------------------------------------------------
# Modo de execução da aplicação: development | production | test
NODE_ENV=production

# Nível de detalhamento dos logs: debug | info | warn | error
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. REDE E SERVIDOR HTTP / HTTPS
# ------------------------------------------------------------------------------
# Endereço de escuta do servidor (0.0.0.0 escuta em todas as placas de rede)
# Nota: BIND_ADDRESS é suportado como alias alternativo
HOST=0.0.0.0

# Porta para o servidor HTTP não-criptografado (acesso PWA e download do certificado)
# Nota: PORT é suportado como fallback alternativo para plataformas PaaS
HTTP_PORT=8080

# Porta para o servidor HTTPS seguro com Range Requests (Streaming VR para iPhone/Web)
HTTPS_PORT=8443

# Anúncio de rede local Zero-Config (mDNS / Bonjour para vrplayer.local)
MDNS_ENABLED=true
MDNS_HOSTNAME=vrplayer

# ------------------------------------------------------------------------------
# 3. DIRETÓRIOS DA BIBLIOTECA DE VÍDEOS
# ------------------------------------------------------------------------------
# Diretório principal de mídia (padrão relativo à raiz do projeto)
VIDEO_DIR=./videos

# Diretórios adicionais separados por vírgula ou ponto-e-vírgula (Windows ou Linux)
# Exemplo Windows: VIDEO_DIRS=D:\FilmesVR,E:\MeusVR
# Exemplo Linux:   VIDEO_DIRS=/media/storage/vr,/home/user/videos
VIDEO_DIRS=

# ------------------------------------------------------------------------------
# 4. INTEGRAÇÃO COM NUVEM & DEBRID (OPCIONAL)
# ------------------------------------------------------------------------------
# Chave de API da sua conta Torbox (para streaming direto de torrents e web downloads)
# Obtenha em: https://torbox.app/settings
# Deixe em branco se não utilizar
TORBOX_API_KEY=

# Token de usuário do Gofile (opcional - estende limites e acessa pastas privadas)
# Obtenha na sua conta em: https://gofile.io/myProfile
# Deixe em branco se não utilizar
GOFILE_TOKEN=

# ------------------------------------------------------------------------------
# 5. CERTIFICADOS SSL / TLS
# ------------------------------------------------------------------------------
# Diretório onde os certificados locais gerados pelo mkcert são armazenados
CERTS_DIR=./certs

# Caminhos customizados opcionais para certificados TLS existentes (descomente se usar)
# SSL_CERT_PATH=./certs/cert.pem
# SSL_KEY_PATH=./certs/key.pem
# SSL_CA_PATH=./certs/rootCA.crt

# ------------------------------------------------------------------------------
# 6. BINÁRIOS E ACELERAÇÃO DE HARDWARE
# ------------------------------------------------------------------------------
# Acelerador de codificação para transcodificação dinâmica HLS: auto | nvenc | qsv | cpu
HARDWARE_ENCODER=auto

# Caminhos explícitos para executáveis caso não utilize os binários da pasta bin/
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# MKCERT_PATH=C:\mkcert\mkcert.exe
